{
  "name": "mapper",
  "version": "0.3.0",
  "description": "Generate standalone, CSS-themeable SVG maps from a region and a stylesheet.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./themes/*.css": "./themes/*.css",
    "./palettes/*.css": "./palettes/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "themes",
    "palettes",
    "data"
  ],
  "scripts": {
    "build": "tsup && node scripts/emit-stylesheets.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/topojson-client": "^3.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
