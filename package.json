{
  "name": "neatline",
  "version": "0.14.0",
  "description": "Generate standalone, CSS-themeable SVG maps from a region and a stylesheet.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./themes/*.css": "./themes/*.css",
    "./palettes/*.css": "./palettes/*.css",
    "./typefaces/*.css": "./typefaces/*.css",
    "./package.json": "./package.json"
  },
  "browser": {
    "node:fs/promises": false
  },
  "files": [
    "dist",
    "themes",
    "palettes",
    "typefaces",
    "data"
  ],
  "scripts": {
    "build": "tsup && node scripts/emit-stylesheets.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tool.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "check": "npm run build:data && npm run typecheck && npm run test && npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check",
    "build:data": "node scripts/build-data.mjs",
    "fetch:data": "node scripts/fetch-natural-earth.mjs",
    "tool:dev": "vite",
    "tool:build": "vite build && node scripts/verify-tool.mjs",
    "tool:preview": "vite preview",
    "gallery": "node scripts/build-gallery.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@mapbox/maki": "^8.2.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.27.7",
    "sane-topojson": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
